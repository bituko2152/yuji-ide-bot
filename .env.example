# Copy to .env and fill in. .env is git-ignored: never commit real values.

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=
# Main server: slash commands are registered here (other servers: config.json "extra_servers")
GUILD_ID=

# Steam login token for leaderboards (/record) and replay asset downloads.
# Created by `npm run steam-login` (asks for the Steam login once, stores only this token).
STEAM_REFRESH_TOKEN=

# Supabase project for /results upload. The service role key bypasses RLS: server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Upload key of the league website's replay storage (/upload replay)
REPLAYS_UPLOAD_KEY=
